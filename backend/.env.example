DATABASE_URL="postgresql://ayiti_alet:ayiti_alet_dev@localhost:5432/ayiti_alet"
JWT_SECRET="chanje-sekrè-sa-a"

# OBLIGATWA an pwodiksyon pou reyajisman modpas mache (san sa a, kòd yo
# ekri nan jounal sèvè a sèlman — itilizatè yo pa ka wè yo). Sipòte nenpòt
# founisè SMTP: Gmail (ak "app password"), SendGrid, Mailgun, elatriye.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opsyonèl: itilize pou lòt fonksyon SMS posib nan lavni (pa itilize pou
# reyajisman modpas ankò — sa a pase pa imèl kounye a).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Opsyonèl: gade DEPLOY.md pou enstriksyon Firebase Cloud Messaging (push)
FIREBASE_SERVICE_ACCOUNT=

# OBLIGATWA an pwodiksyon (san sa a, kle chifreman tanporè jenere chak fwa
# sèvè a rekòmanse, e ansyen dokiman chifre yo vin ilizib). Jenere yon kle
# valid ak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Rekòmande an pwodiksyon: limite ki sit ka rele API a (CORS). Plizyè domèn
# ka separe ak virgil. San sa a, tout orijin aksepte (bon pou devlopman).
FRONTEND_URL=

# Mete "production" an pwodiksyon — sa fòse sèvè a refize kreye/dechifre
# dokiman idantite si ENCRYPTION_KEY pa konfigire, olye itilize yon kle
# tanporè an silans.
NODE_ENV=
